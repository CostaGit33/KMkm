# Copie para .env.staging e preencha valores exclusivos da homologação.
# Nunca reutilize DATABASE_URL, senhas, TAG_KEY_SECRET ou credenciais R2 da produção.

STAGING_HTTP_PORT=3001
MYSQL_DATABASE=mais1km_staging
MYSQL_USER=mais1km_staging
MYSQL_PASSWORD=SUBSTITUA_POR_SENHA_ALEATORIA_URL_SAFE
MYSQL_ROOT_PASSWORD=SUBSTITUA_POR_OUTRA_SENHA_ALEATORIA

DATABASE_URL=mysql://mais1km_staging:SUBSTITUA_POR_SENHA_ALEATORIA_URL_SAFE@db-staging:3306/mais1km_staging
PORT=3000
APP_TZ=America/Bahia
NODE_ENV=production
RELEASE_VERSION=staging-local
APP_PUBLIC_URL=https://SEU-DOMINIO-DE-HOMOLOGACAO
CONTATO_EMAIL=silvaromulo33@gmail.com

# Segredo exclusivo da homologação (32+ bytes aleatórios).
TAG_KEY_SECRET=GERE_UM_SEGREDO_EXCLUSIVO_DE_HOMOLOGACAO
GEOFENCE_RAIO_PADRAO_M=100
EXIGIR_AUTORIZACAO=true
COOKIE_SAMESITE=Lax
CSP_LEGADO=false

# Homologação começa sem integrações externas e sem compartilhamento de mídia.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAP_ID=
RESEND_API_KEY=
RESEND_FROM=
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0
N8N_EVENTS_WEBHOOK_URL=
N8N_EVENTS_SECRET=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MEDIA_DIR=/data/media
FRAME_ANCESTORS=
ORIGENS_PERMITIDAS=
