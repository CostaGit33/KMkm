            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 e conta criada\", () => {",
                  "  pm.response.to.have.status(201);",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.usuario.email).to.eql(pm.collectionVariables.get(\"emailTeste\"));",
                  "  pm.expect(j.usuario.id).to.be.a(\"number\");",
                  "});",
                  "pm.test(\"cookie de sessão HttpOnly\", () => {",
                  "  const c = pm.response.headers.get(\"Set-Cookie\") || \"\";",
                  "  pm.expect(c).to.include(\"mais1km_session=\");",
                  "  pm.expect(c).to.include(\"HttpOnly\");",
                  "});"
                ]
