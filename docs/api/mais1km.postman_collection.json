              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sufixo = Date.now() + \"-\" + Math.floor(Math.random() * 1e6);",
                  "pm.collectionVariables.set(\"emailTeste\", \"postman-\" + sufixo + \"@teste.invalid\");",
                  "pm.collectionVariables.set(\"senhaTeste\", \"Senha-Teste-12345\");"
                ]
