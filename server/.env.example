DATABASE_URL=mysql://caderneta:caderneta@127.0.0.1:3306/caderneta
PORT=3000
APP_TZ=America/Bahia
RELEASE_VERSION=local
# Google Maps JavaScript API (sem chave válida, o app usa OpenStreetMap como alternativa).
GOOGLE_MAPS_API_KEY=
# Opcional: Map ID configurado no Google Cloud; pode ficar vazio para usar o mapa padrão.
GOOGLE_MAP_ID=
# E-mail exibido nas páginas públicas de privacidade e exclusão de conta.
CONTATO_EMAIL=
# Rastreio de erros (opcional). Sem SENTRY_DSN o Sentry fica desligado e nada é enviado.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# Monitoramento de latência: 0 desliga; recomendado começar com 0.05 ou 0.1.
SENTRY_TRACES_SAMPLE_RATE=0
# Recuperação de senha por e-mail (Resend). Não comitar os valores reais.
RESEND_API_KEY=
# Remetente verificado no Resend, por exemplo Mais1km <conta@seudominio.com.br>
RESEND_FROM=
# URL pública HTTPS da aplicação, sem barra final; usada no link de redefinição.
APP_PUBLIC_URL=
# Eventos operacionais enviados ao n8n (somente HTTPS; segredo com 32+ caracteres).
N8N_EVENTS_WEBHOOK_URL=
N8N_EVENTS_SECRET=

# --- Segurança do carimbo e da conta (veja docs/seguranca.md) ---
# Segredo das chaves dos links das tags (?k=). 32+ caracteres aleatórios; guarde fora do repositório.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TAG_KEY_SECRET=
# Raio padrão (metros) para exigir localização no carimbo. Padrão obrigatório: 100 m.
# Pontos sem coordenadas válidas não aceitam carimbo. Precisão GPS exigida: até 50 m.
GEOFENCE_RAIO_PADRAO_M=100
# Exige responsável, autorização e vistoria registrados para publicar um ponto (false desliga).
EXIGIR_AUTORIZACAO=true
# Saída temporária se a CSP estrita quebrar algo em produção; volte para false depois de corrigir.
CSP_LEGADO=false
# Sites autorizados a embutir o app em iframe (padrão: nenhum além do próprio). Ex.: https://exemplo.com
FRAME_ANCESTORS=
# Origens extras aceitas em pedidos que alteram dados (padrão: só o próprio host). Separe por vírgula.
ORIGENS_PERMITIDAS=
# SameSite do cookie de sessão: Lax (padrão), Strict ou None (só se o app for embutido em outro site; exige HTTPS).
COOKIE_SAMESITE=Lax
